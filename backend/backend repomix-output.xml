         es_directo AS "esDirecto", 
         costo_asignado_directo AS "costoAsignadoDirecto"
       FROM sede_areas 
       WHERE sede_id::text = $1 
       ORDER BY id ASC;`,
      [String(id)]
    );
    res.json(result.rows);
  } catch (error) {
    res.status(500).json({ error: 'Error al consultar las áreas de la sede: ' + error.message });
