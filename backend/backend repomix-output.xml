const pool = require('../config/db');
const { calcularCostoMinuto, calcularCostoExamen } = require('../services/costEngine');

const resolveConvenioId = async (convenioId) => {
  const id = convenioId !== undefined && convenioId !== null && convenioId !== '' ? Number(convenioId) : null;
  if (id) return id;

  const generalConvenio = await pool.query(`
    SELECT id FROM convenios WHERE LOWER(TRIM(nombre_eps)) = 'general' LIMIT 1;
  `);
  return generalConvenio.rows[0]?.id ?? null;
};

const getTarifaConvenioMap = async (convenioId) => {
  const selectedConvenioId = await resolveConvenioId(convenioId);
  if (!selectedConvenioId) return {};

  const tarifaRes = await pool.query(`
    SELECT examen_id, tarifa_acordada FROM tarifas_convenios WHERE convenio_id = $1;
  `, [selectedConvenioId]);

  return tarifaRes.rows.reduce((acc, row) => {
    acc[String(row.examen_id)] = Number(row.tarifa_acordada || 0);
    return acc;
  }, {});
};

const evaluarSede = async (req, res) => {
  const { sedeId } = req.params;
  const convenioId = req.query.convenioId || req.query.convenio || null;

  try {
    // 1. Buscar sede por ID o coincidencia de nombre
    const sedeRes = await pool.query(`
      SELECT
        id,
        nombre,
        COALESCE(arriendo_mensual, 0) AS arriendo,
        COALESCE(servicios_publicos, 0) AS servicios,
        COALESCE(nomina_admin, 0) AS admin,
        COALESCE(mantenimiento_otros, 0) AS mtto,
        COALESCE(volumen_mensual_esperado, 1) AS volumen
      FROM sedes
      WHERE id::text = $1 
         OR LOWER(nombre) LIKE LOWER('%' || $1 || '%')
      LIMIT 1;
    `, [String(sedeId)]);

    if (sedeRes.rows.length === 0) {
      return res.status(404).json({ error: 'Sede no encontrada' });
    }

    const sede = sedeRes.rows[0];

    // Total Fijo General de la Sede por componentes
    const totalFijoSede =
      Number(sede.arriendo) +
      Number(sede.servicios) +
      Number(sede.admin) +
      Number(sede.mtto);

    // 2. Consultar Sub-bolsas asociadas filtrando sólo áreas directas
    const areasRes = await pool.query(`
      SELECT COALESCE(SUM(costo_asignado_directo), 0) AS sub_bolsa
      FROM sede_areas
      WHERE sede_id::text = $1 AND es_directo = true;
    `, [String(sede.id)]);

    const subBolsaSum = Number(areasRes.rows[0]?.sub_bolsa || 0);
    const costoFijoBolsa = subBolsaSum > 0 ? subBolsaSum : totalFijoSede;

    // Objeto de sede efectivo con la sub-bolsa para costEngine
    const sedeEfectiva = {
      ...sede,
      costoFijoBolsa,
      subBolsaActiva: subBolsaSum > 0
    };

    // 3. Obtener Roles y Exámenes
    const rolesRes = await pool.query(`
      SELECT id, cargo AS nombre, sueldo_base, porcentaje_provisiones AS prov_pct, horas_mes FROM personal_cargos;
    `);

    const examenesRes = await pool.query(`
      SELECT
        e.id,
        e.nombre,
        COALESCE(e.minutos_medico, 0) AS min_medico,
        COALESCE(e.minutos_asistencial, 0) AS min_asis,
        COALESCE(e.duracion_minutos, (COALESCE(e.minutos_medico, 0) + COALESCE(e.minutos_asistencial, 0)), 30) AS duracion_minutos,
        COALESCE(i.costo_insumos_detalle, e.costo_insumos_directos, 0) AS insumos,
        e.costo_depreciacion_equipos AS cips,
        e.tarifa_soat_referencia AS tarifa_convenio,
        COALESCE(e.volumen_mes_proyectado, 30) AS vol_mes
      FROM examenes e
      LEFT JOIN (
        SELECT examen_id, SUM(cantidad * valor_unitario) AS costo_insumos_detalle
        FROM insumos_detalle
        GROUP BY examen_id
      ) i ON i.examen_id = e.id
      ORDER BY e.id ASC;
    `);

    const rolesMap = {};
    rolesRes.rows.forEach((rol) => {
      const claveRol = String(rol.id || rol.nombre || '').toLowerCase();
      rolesMap[claveRol] = calcularCostoMinuto(
        Number(rol.sueldo_base) || 0,
        Number(rol.prov_pct) || 0,
        Number(rol.horas_mes) || 1
      );
      if (rol.id === 'medico') rolesMap.medico = rolesMap[claveRol];
      if (rol.id === 'asistencial') rolesMap.asistencial = rolesMap[claveRol];
    });

    const tarifaConvenioMap = await getTarifaConvenioMap(convenioId);

    const evaluacion = examenesRes.rows.map((examen) => {
      const tarifaConvenio = Number(
        tarifaConvenioMap[String(examen.id)] ?? examen.tarifa_convenio ?? 0
      ) || 0;

      // Inyectar sedeEfectiva con el costoFijoBolsa calculado
      const calculo = calcularCostoExamen({ ...examen, tarifa_convenio: tarifaConvenio }, rolesMap, sedeEfectiva);

      return {
        ...calculo,
        examenId: examen.id,
        nombre: examen.nombre || `Examen #${examen.id}`,
        volumen: Number(examen.vol_mes) || Number(calculo.volumen) || 30,
        tiempoMinutos: Number(examen.duracion_minutos) || Number(calculo.tiempoMinutos) || 30,
        tarifaConvenio
      };
    });

    res.json({
      sedeId: sede.id,
      nombreSede: sede.nombre,
      costoFijoBolsa,
      evaluacion
    });
  } catch (error) {
    res.status(500).json({ error: 'Error al evaluar la sede: ' + error.message });
  }
};

module.exports = { evaluarSede };
